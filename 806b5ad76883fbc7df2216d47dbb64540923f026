      "writtenOn": "2020-12-15T14:58:20Z",
      "side": 1,
      "message": "upstream has pymysql and sshtunnel as requirements, but not here",
      "revId": "806b5ad76883fbc7df2216d47dbb64540923f026",
      "serverId": "270e2033-b340-4cff-9539-693957ebf0e7",
      "unresolved": false
